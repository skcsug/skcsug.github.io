---
import '../styles/global.css';
import RmseChart from '../components/RmseChart.astro';
import { profile, education, activities, featured, featuredStats, others } from '../data/profile';

// 세 프로젝트를 같은 틀(문제 정의 · 역할 · 기술 · 결과 숫자)로 그립니다. IBA만 RMSE 그래프가 붙습니다.
const projects = [{ ...featured, stats: featuredStats }, ...others.map((o) => ({ ...o, rmse: undefined, finalN: undefined }))];
const githubLabel = profile.github.replace('https://', '');
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
    <title>{profile.nickname} · 포트폴리오</title>
    <meta name="description" content={`${profile.nickname} — ${profile.tagline}. 대표 프로젝트: ${featured.title}`} />
  </head>
  <body>
    <div class="layout">
      <aside class="profile">
        <div class="avatar" aria-hidden="true">{profile.nickname[0].toUpperCase()}</div>
        <h1>{profile.nickname}</h1>
        <p class="tagline">{profile.tagline}</p>
        <div class="buttons">
          <a class="btn" href={profile.github}>GitHub · {githubLabel}</a>
          {profile.resumeUrl
            ? <a class="btn" href={profile.resumeUrl} download>이력서 PDF 받기</a>
            : <span class="btn disabled" aria-disabled="true">이력서 PDF (준비 중)</span>}
        </div>

        <h2>관심 분야</h2>
        <p class="goal">{profile.goal}</p>
        <ul class="interests">{profile.interests.map((i) => <li>{i}</li>)}</ul>

        <h2>Skills</h2>
        <ul class="tags">{profile.skills.map((s) => <li>{s}</li>)}</ul>
      </aside>

      <main class="content">
        <section class="block">
          <h2>Education</h2>
          <ul class="edu">
            {education.map((e) => (
              <li>
                <span class="edu-degree">{e.degree}, {e.major}</span>
                <span class="edu-school">{e.school} (<em>{e.period}</em>)</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="block">
          <h2>Activities</h2>
          <ul class="edu">
            {activities.map((a) => (
              <li>
                <span class="edu-degree">{a.name}</span>
                <span class="edu-school">{a.sub} (<em>{a.period}</em>)</span>
              </li>
            ))}
          </ul>
        </section>

        <h2>Projects</h2>

        {projects.map((p) => (
          <details class="project">
            <summary><span class="ptitle">{p.title}</span></summary>
            <div class="body">
              <h4>문제 정의</h4>
              <p>{p.problem}</p>

              <h4>역할</h4>
              <ul>{p.role.map((r) => <li>{r}</li>)}</ul>

              <h4>기술</h4>
              <ul>{p.tech.map((t) => <li>{t}</li>)}</ul>

              <h4>결과</h4>
              <div class="stats">
                {p.stats.map((st, i) => (
                  <div class={i === 0 ? 'stat best' : 'stat'}><b>{st.value}</b><span>{st.label}</span></div>
                ))}
              </div>
              {p.rmse && <RmseChart points={p.rmse} finalN={p.finalN!} />}
            </div>
          </details>
        ))}

        <footer>
          <a href={profile.github}>{githubLabel}</a> · Built with Astro · Hosted on GitHub Pages
        </footer>
      </main>
    </div>
  </body>
</html>
