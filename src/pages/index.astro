---
import '../styles/global.css';
import ProjectArticle from '../components/ProjectArticle.astro';
import { profile, education, activities, featured, featuredStats, otherProjects, contests } from '../data/profile';

const projects = [{ ...featured, stats: featuredStats }, ...otherProjects];
// 한눈에 보기: 가장 강한 결과(대회)부터
const highlights = [...contests, ...otherProjects, featured];
const githubLabel = profile.github.replace('https://', '');
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
    <title>{profile.nickname} · 포트폴리오</title>
    <meta name="description" content={`${profile.nickname} — ${profile.tagline}. 대표 프로젝트: ${featured.title}`} />
    <!-- 링크 공유 미리보기 (카톡·메신저·SNS) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://skcsug.github.io/" />
    <meta property="og:title" content={`${profile.nickname} · 포트폴리오`} />
    <meta property="og:description" content={`${profile.tagline} · 데이터·ML 프로젝트와 대회 기록`} />
    <meta property="og:image" content="https://skcsug.github.io/profile.jpg" />
    <meta property="og:image:width" content="256" />
    <meta property="og:image:height" content="256" />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header class="hero">
      <div class="avatar"><img src="/profile.jpg" alt={`${profile.nickname} 프로필 사진`} width="120" height="120" /></div>
      <div class="hero-text">
        <p class="nickname">{profile.nickname}</p>
        <h1>{profile.headline}</h1>
        <div class="buttons">
          <a class="btn" href={profile.github}>GitHub</a>
          {profile.resumeUrl
            ? <a class="btn" href={profile.resumeUrl} download>Resume</a>
            : <span class="btn disabled" aria-disabled="true">Resume (준비 중)</span>}
          <a class="btn" href={`mailto:${profile.email}`}>{profile.email}</a>
        </div>
      </div>
    </header>

    <div class="layout">
      <aside class="profile">
        <h2>관심 분야</h2>
        <p class="goal">{profile.goal}</p>
        <ul class="interests">{profile.interests.map((i) => <li>{i}</li>)}</ul>

        <h2>Skills</h2>
        <ul class="tags">{profile.skills.map((s) => <li>{s}</li>)}</ul>
        <p class="skills-others"><span>Others</span> {profile.otherSkills.join(' · ')}</p>
      </aside>

      <main class="content">
        <section class="block">
          <h2>Highlights</h2>
          <table class="highlights">
            <thead><tr><th>프로젝트</th><th>기간</th><th>팀</th></tr></thead>
            <tbody>
              {highlights.map((h) => (
                <tr>
                  <td><a href={`#${h.id}`}>{h.title}</a>{h.demo && <> · <a class="demo-link" href={h.demo}>데모</a></>}</td>
                  <td class="muted">{h.period}</td>
                  <td class="muted">{h.team}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <section class="block">
          <h2>Education</h2>
          <ul class="edu">
            {education.map((e) => (
              <li>
                <span class="edu-degree">{e.degree}, {e.major}</span>
                <span class="edu-school">{e.school} (<em>{e.period}</em>)</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="block">
          <h2>Activities</h2>
          <ul class="edu">
            {activities.map((a) => (
              <li>
                <span class="edu-degree">{a.name}</span>
                <span class="edu-school">{a.sub} (<em>{a.period}</em>)</span>
              </li>
            ))}
          </ul>
        </section>

        <h2>Projects</h2>
        <div class="project-list">{projects.map((p) => <ProjectArticle item={p} />)}</div>

        <h2 class="section-gap">Contest</h2>
        <div class="project-list">{contests.map((c) => <ProjectArticle item={c} />)}</div>

        <footer>
          <a href={profile.github}>{githubLabel}</a> · Built with Astro · Hosted on GitHub Pages
        </footer>
      </main>
    </div>
  </body>
</html>
