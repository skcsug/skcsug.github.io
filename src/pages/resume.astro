---
// 이력서 인쇄용 페이지. `npm run resume`이 이 페이지를 A4 PDF(public/resume.pdf)로 저장합니다.
import { header, projects, tables } from '../data/resume';

// **굵게** 표시만 허용하고 나머지는 이스케이프합니다.
const rich = (t: string) =>
  t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\*\*(.+?)\*\*/g, '<b>$1</b>');
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{header.name} 이력서</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
    <style>
      @page { size: A4; margin: 14mm 15mm; }
      * { box-sizing: border-box; }
      body { margin: 0; background: #fff; color: #1f2328; font-family: 'Pretendard', -apple-system, 'Apple SD Gothic Neo', sans-serif; font-size: 10pt; line-height: 1.55; word-break: keep-all; }
      .page { max-width: 180mm; margin: 0 auto; }
      b { font-weight: 700; }

      .top { display: grid; grid-template-columns: 26mm 1fr 52mm; gap: 6mm; align-items: start; margin-bottom: 7mm; }
      .photo { width: 26mm; height: 26mm; border-radius: 50%; overflow: hidden; }
      .photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
      h1 { margin: 0; font-size: 20pt; line-height: 1.2; }
      h1 small { font-size: 10.5pt; font-weight: 500; color: #59636e; margin-left: 2mm; }
      .school { font-weight: 700; margin: 1.5mm 0 2mm; }
      .intro { margin: 0; padding-left: 4.5mm; }
      .intro li { margin: 0.4mm 0; }
      .contacts { font-size: 9.5pt; }
      .contacts div { margin-bottom: 1mm; }
      .contacts b { margin-right: 1.5mm; }

      .project { margin-bottom: 6mm; break-inside: avoid-page; }
      .project h2 { margin: 0; font-size: 15pt; }
      .project h2 span { font-size: 9.5pt; font-weight: 400; color: #59636e; margin-left: 2mm; }
      .summary { font-weight: 700; font-size: 11pt; margin: 2mm 0 0.5mm; }
      .summary em { font-style: normal; font-size: 9pt; margin-left: 2mm; color: #2563eb; }
      .stack { color: #59636e; font-size: 9pt; margin: 0 0 2mm; }
      h3 { font-size: 9.5pt; margin: 2.2mm 0 0.8mm; }
      .project p { margin: 0; }
      .project ul { margin: 0; padding-left: 4.5mm; }
      .project li { margin: 0.4mm 0; }

      .tables h2 { font-size: 15pt; margin: 2mm 0 3mm; }
      h4 { font-size: 10pt; margin: 3mm 0 1mm; }
      table { width: 100%; border-collapse: collapse; border-top: 1.2px solid #1f2328; }
      td { padding: 1.3mm 0; border-bottom: 1px solid #e5e7eb; }
      td:last-child { text-align: right; color: #59636e; white-space: nowrap; padding-left: 4mm; }
      .two { display: grid; grid-template-columns: 1fr 1fr; gap: 6mm; }

      @media screen { body { padding: 12mm 4mm; } }
    </style>
  </head>
  <body>
    <main class="page">
      <section class="top">
        <div class="photo"><img src="/profile.jpg" alt={`${header.name} 사진`} /></div>
        <div>
          <h1>{header.name}<small>{header.role}</small></h1>
          <div class="school">{header.school}<br />{header.schoolNote}</div>
          <ul class="intro">{header.intro.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="contacts">
          {header.contacts.map((c) => <div><b>{c.label}</b>{c.value}</div>)}
        </div>
      </section>

      {projects.map((p) => (
        <article class="project">
          <h2>{p.name}<span>{p.period}</span></h2>
          <div class="summary">{p.summary}<em>{p.badge}</em></div>
          <div class="stack">{p.stack}</div>
          {p.sections.map((s) => (
            <>
              <h3>| {s.title}</h3>
              {s.list
                ? <ul>{s.items.map((t) => <li set:html={rich(t)} />)}</ul>
                : <p set:html={rich(s.items[0])} />}
            </>
          ))}
        </article>
      ))}

      <section class="tables">
        <h2>학력, 활동, 어학</h2>
        <h4>학력</h4>
        <table>{tables.education.map((r) => <tr><td>{r.left}</td><td>{r.right}</td></tr>)}</table>
        <h4>활동</h4>
        <table>{tables.activities.map((r) => <tr><td>{r.left}</td><td>{r.right}</td></tr>)}</table>
        <div class="two">
          <div>
            <h4>어학</h4>
            <table>{tables.language.map((r) => <tr><td>{r.left}</td><td>{r.right}</td></tr>)}</table>
          </div>
          <div>
            <h4>대회 참가</h4>
            <table>{tables.contests.map((r) => <tr><td>{r.left}</td><td>{r.right}</td></tr>)}</table>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
